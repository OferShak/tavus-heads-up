{
  "name": "over-my-head",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:tunnel": "OMH_TUNNEL=1 vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "wrangler types --strict-vars=false >/dev/null && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-pal": "node --experimental-strip-types scripts/setup-pal.ts",
    "types": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.95.0",
    "marked": "^18.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
